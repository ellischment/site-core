# Скопировать в .env и заполнить. Секреты генерировать: openssl rand -hex 32
# Проверка при старте: lib/env.ts

# База SQLite. Относительный путь считается от prisma/schema: база ляжет в
# prisma/data/. На сервере путь абсолютный: file:/app/prisma/data/app.db
DATABASE_URL="file:../data/app.db"

# Ключ шифрования имён и телефонов в заявках (32+ символа)
ENCRYPTION_KEY=""
# Ключ для /api/cron?key=... (16+ символов)
CRON_SECRET=""
# Адрес сайта: канонические ссылки, sitemap, OG
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# 1 закрывает сайт от индексации целиком (тестовый домен)
NEXT_PUBLIC_NOINDEX=""

# Владелец для npm run seed (пароль сменить после первого входа)
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""
# Необязательно: администратор (роль без разделов владельца)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Уведомления о заявках. Пусто: заявки только в админке
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Релей для сервера, где api.telegram.org недоступен. Пусто: напрямую
TELEGRAM_API_BASE=""

# Папка копий базы (scripts/backup.sh)
BACKUP_DIR=""
